{
  "info": {
    "name": "AdoptMeBack API",
    "description": "Colección de APIs para AdoptMeBack",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "base_url",
      "value": "http://localhost:3006",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('token', response.token);",
                  "    pm.collectionVariables.set('token', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"contrasena\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/usuarios/login",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
